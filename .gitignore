# ---------------------------------------------------------------------------
# Financial data must never be committed.
# The real database lives in %LOCALAPPDATA%\OpenISave2\, never in this repo;
# these rules are a second line of defence against stray copies.
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
.localdata/
data/
backups/
logs/
exports/
*.log
*.csv
*.ofx
*.qif
*.bak
report-*.pdf
report-*.json

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
credentials.json
secrets.json

# ---------------------------------------------------------------------------
# Build output and dependencies (all regenerable)
# ---------------------------------------------------------------------------

# Release packages - publish installers via GitHub Releases, not commits
/release/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# PyInstaller (the tracked backend/openisave_server.spec is source, not output)
backend/build/
backend/dist/
*.manifest
warn-*.txt
xref-*.html

# Node / Vite
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Tauri
target/
desktop/gen/
desktop/binaries/
*.pdb

# Installers and large binaries that end up outside target/
*.msi
*-setup.exe
*.zip
*.7z

# ---------------------------------------------------------------------------
# Editors, IDEs and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
~$*
