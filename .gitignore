# ---------------------------------------------------------------------------
# Financial data must never be committed.
# The real (encrypted) database lives in %LOCALAPPDATA%\OpenISave2Data\ and
# 2.0.x plaintext data in %LOCALAPPDATA%\OpenISave2\, never in this repo;
# these rules are a second line of defence against stray copies.
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.migrating
*.db.restoring
*.sqlite
*.sqlite3
*.sqlcipher
.localdata/
.localdata-legacy/
data/
vault/
backups/
migration/
logs/
exports/
security-exports/

# Recovery keys and security exports (never commit, never keep in the repo).
# Patterns target exported files only, so source such as RecoveryKeyModal.tsx
# stays tracked.
*recovery-key*.txt
*recovery_key*.txt
*recovery-key*.json
*.recovery
migration-report.json
*.log
# Bank and wallet statements (e.g. 微信支付账单流水文件*.xlsx) are sensitive.
# Tests build synthetic statements in memory (backend/tests/wechat_fixture.py);
# a redacted fixture file may be committed only under backend/tests/fixtures/.
*.xlsx
*.xls
*微信支付账单*
*支付宝*账单*
!backend/tests/fixtures/*.xlsx
import-temp/
imports-temp/
test-output/
# UI review screenshots are taken against a live vault and may show real
# balances; keep them local.
docs/ui-review/
*.csv
*.ofx
*.qif
*.bak
report-*.pdf
report-*.json

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
credentials.json
secrets.json

# ---------------------------------------------------------------------------
# Build output and dependencies (all regenerable)
# ---------------------------------------------------------------------------

# Release packages - publish installers via GitHub Releases, not commits
/release/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# PyInstaller (the tracked backend/openisave_server.spec is source, not output)
backend/build/
backend/dist/
*.manifest
warn-*.txt
xref-*.html

# Node / Vite
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Tauri
target/
desktop/gen/
desktop/binaries/
*.pdb

# Installers and large binaries that end up outside target/
*.msi
*-setup.exe
*.zip
*.7z

# ---------------------------------------------------------------------------
# Editors, IDEs and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
~$*
